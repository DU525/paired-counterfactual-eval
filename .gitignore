# ---------------------------------------------------------------------------
# Baseline .gitignore for research / evaluation repositories.
# Layered by reason so a reviewer can see WHAT is excluded and WHY.
# ---------------------------------------------------------------------------

# --- 1. Secrets and credentials (NEVER commit) --------------------------------
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials.json
credentials.yaml
secrets.json
secrets.yaml
service-account*.json
.netrc
.npmrc
id_rsa
id_ed25519
id_ecdsa
known_hosts
*.secret

# --- 2. Experiment outputs and artifacts (regenerate, never commit) ---------
outputs/
artifacts/
results/
runs/
logs/
wandb/
mlruns/
checkpoints/
weights/
*.ckpt
*.safetensors
*.pth
*.pt
*.onnx
*.engine
*.npz
*.npy
*.h5
*.hdf5
*.parquet
*.arrow
*.pkl
*.pickle
*.joblib
*.log
*.pid

# --- 3. Datasets (publish via script + checksum, not via git) ---------------
data/
datasets/
*.csv.gz
!docs/**/*.csv

# --- 4. Python -------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
.pyre/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
nosetests.xml
.tox/
.nox/
.cache
cython_debug/

# --- 5. Jupyter -----------------------------------------------------------
.ipynb_checkpoints/
*.nbconvert.ipynb

# --- 6. Node / frontend ----------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnpm-store/
.next/
.nuxt/
.output/
.svelte-kit/
.vite/
.turbo/
.cache/

# --- 7. Editors / OS -------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
*.sublime-*

# --- 8. AI / agent tool local state (do not publish tool state) -------------
.opencode/
.trae/
.mavis/
.harness/
.claude/
.cursor/
.codex/
.aider*
continue/
AGENTS.local.md
CLAUDE.local.md

# --- 9. Docs build output --------------------------------------------------
_site/
.jekyll-cache/
.docusaurus/
.nextra/
site/

# --- 10. Scratch / local ---------------------------------------------------
scratch/
tmp/
temp/
*.bak
*.orig
*.rej
*~